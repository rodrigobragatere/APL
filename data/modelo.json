  "indicadores": [
    {
      "id": "esforco-pd",
      "nome": "Esforço de P&D",
      "formula": "ESP&D = Σ(GASP&D_i) / Σ(FAT_i) × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": ["ABIT", "SEBRAE", "Instituições de Classe"],
      "fontesSecundarias": [],
      "interpretacao": "Quanto maior, maior a capacidade de competição do APL.",
      "faixaReferencia": { "min": 0, "max": 15, "ideal": 5 }
    },
    {
      "id": "valor-adicionado",
      "nome": "Valor Adicionado à Produção",
      "formula": "VAP = (RLV - CO - GASSAL) / PEOC × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": ["ABIT", "SEBRAE", "Instituições de Classe"],
      "fontesSecundarias": [],
      "interpretacao": "Quanto maior, maior o valor agregado nas atividades do APL.",
      "faixaReferencia": { "min": 0, "max": 100, "ideal": 40 }
    },
    {
      "id": "relevancia-emprego",
      "nome": "Relevância do Emprego",
      "formula": "RELEMPR = EMPR_APL / EMPR_município",
      "unidade": "UN",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["RAIS / MTE", "IBGE"],
      "interpretacao": "Quanto maior, melhor a posição do APL quanto à geração de emprego.",
      "faixaReferencia": { "min": 0, "max": 1, "ideal": 0.3 }
    },
    {
      "id": "esforco-atualizacao-tecnologica",
      "nome": "Esforço de Atualização Tecnológica",
      "formula": "ESA&T = Σ(GAS_A&T_i) / Σ(FAT_i) × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": ["ABIT", "SEBRAE", "Instituições de Classe"],
      "fontesSecundarias": [],
      "interpretacao": "Maior esforço indica maior vantagem competitiva sustentável.",
      "faixaReferencia": { "min": 0, "max": 20, "ideal": 8 }
    },
    {
      "id": "participacao-mercados",
      "nome": "% Participação nos Mercados Interno e Externo",
      "formula": "PM = (FAT_interno + FAT_externo) / FAT_total × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": ["ABIT", "SEBRAE"],
      "fontesSecundarias": ["IBGE", "FIESC"],
      "interpretacao": "Monitora evolução e inserção mercadológica das empresas do APL.",
      "faixaReferencia": { "min": 0, "max": 100, "ideal": 60 }
    },
    {
      "id": "quociente-locacional",
      "nome": "Quociente Locacional (QL)",
      "formula": "QL = (Emp_i / Emp_total_mun) / (Emp_i_reg / Emp_total_reg)",
      "unidade": "UN",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["RAIS / MTE", "IBGE"],
      "interpretacao": "QL > 1 e participação relativa > 1% indicam APL denso (Britto & Albuquerque, 2002).",
      "faixaReferencia": { "min": 0, "max": 5, "ideal": 1.5 }
    },
    {
      "id": "pct-instituicoes-dinamizam",
      "nome": "% Instituições que Dinamizam o APL",
      "formula": "PI = nI / nE × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": ["FIESC", "SEBRAE", "Prefeitura", "Instituições de Classe"],
      "fontesSecundarias": [],
      "interpretacao": "Indicativo da construção institucional do arranjo.",
      "faixaReferencia": { "min": 0, "max": 50, "ideal": 15 }
    },
    {
      "id": "indice-gini-locacional",
      "nome": "Índice de Gini Locacional",
      "formula": "IG = desigualdade na distribuição de renda domiciliar per capita",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["IBGE", "Prefeitura"],
      "interpretacao": "0 = igualdade máxima; 1 = desigualdade máxima. Valores menores favorecem tecido social.",
      "faixaReferencia": { "min": 0, "max": 1, "ideal": 0.4, "inverso": true }
    },
    {
      "id": "relevancia-empresarial",
      "nome": "Relevância Empresarial",
      "formula": "RELESTAB = ESTAB_APL / ESTAB_região × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["RAIS / MTE", "IBGE"],
      "interpretacao": "Quanto maior, mais evidente a importância das atividades do arranjo para a região.",
      "faixaReferencia": { "min": 0, "max": 100, "ideal": 25 }
    },
    {
      "id": "taxa-cooperacao",
      "nome": "Taxa de Cooperação",
      "formula": "TAXCOOP = EMPR_coop / EMPR_total × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["PINTEC", "SEBRAE"],
      "interpretacao": "Quanto maior, maior o grau de cooperação entre empresas do APL.",
      "faixaReferencia": { "min": 0, "max": 100, "ideal": 45 }
    },
    {
      "id": "num-organizacoes-estruturadas",
      "nome": "Nº Organizações Estruturadas (Governança)",
      "formula": "Contagem de organizações que coordenam transações institucionais e mercadológicas",
      "unidade": "UN",
      "tipo": "quantitativo",
      "fontesPrimarias": ["SEBRAE", "Prefeitura", "Instituições de Classe"],
      "fontesSecundarias": [],
      "interpretacao": "Quanto maior, melhor a representatividade dos atores perante o ambiente externo.",
      "faixaReferencia": { "min": 0, "max": 20, "ideal": 5 }
    },
    {
      "id": "relevancia-valor-transformacao",
      "nome": "Relevância do Valor da Transformação",
      "formula": "VT_APL = ΣVT_ativ / ΣVT_total × 100",
      "unidade": "%",
      "tipo": "quantitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["IBGE (PIA, PAS, PAIC, PAC)"],
      "interpretacao": "Quanto maior, maior o nível de eficiência coletiva.",
      "faixaReferencia": { "min": 0, "max": 100, "ideal": 35 }
    },
    {
      "id": "aprendizagem-interna",
      "nome": "Aprendizagem Interna",
      "formula": "Alta=1; Média=0,66; Baixa=0,33; Sem=0",
      "unidade": "UN",
      "tipo": "qualitativo",
      "fontesPrimarias": [],
      "fontesSecundarias": ["PINTEC"],
      "interpretacao": "Mede importância do P&D como fonte de aprendizagem (Stallivieri, 2009).",
      "faixaReferencia": { "min": 0, "max": 1, "ideal": 0.8 },
      "escalaQualitativa": [
        { "valor": 1, "rotulo": "Alta importância" },
        { "valor": 0.66, "rotulo": "Média importância" },
        { "valor": 0.33, "rotulo": "Baixa importância" },
        { "valor": 0, "rotulo": "Sem importância" }
      ]
    }
  ],
